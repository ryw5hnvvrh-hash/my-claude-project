# 로컬 개발용 비밀값 — 이 파일을 복사해서 `.dev.vars` 로 저장하고 값을 채우세요.
# `.dev.vars` 는 .gitignore에 들어 있어야 하며, 절대 커밋·공유하지 않습니다.
# 배포용은 파일이 아니라 `npx wrangler secret put <이름>` 으로 넣습니다.
#
# ⚠️ 여기 값을 하나도 안 채워도 오피스는 정상 작동합니다.
#    (연동 항목만 화면에 "미설정"으로 표시됩니다)
#    나중에 진짜 Notion·Discord에 보고서를 보내고 싶을 때만 채우세요.

# ── Notion ─────────────────────────────────────────────
# 1) https://www.notion.so/my-integrations 에서 내부 통합 생성 → Secret 복사 (ntn_ 로 시작)
# 2) 보고서를 받을 Notion 페이지 열기 → 우측 상단 ⋯ → 연결 → 만든 통합 추가
#    (이 2단계를 안 하면 API가 404를 냅니다)
NOTION_TOKEN=
# 보고서를 저장할 데이터베이스 ID (Notion DB 주소의 32자리 문자열)
NOTION_BRIEFING_DB=

# ── Discord ────────────────────────────────────────────
# 보고를 받을 채널 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=
